# Claude — powers the shop chat and the buying agent.
# Without it Altus falls back to a deterministic keyword matcher so the demo still runs.
ANTHROPIC_API_KEY=

# Razorpay test mode. Read by nothing right now — pay.creds() returns no
# credentials unconditionally, so checkout is simulated on every path and
# labelled as such. Kept for when live test mode is switched back on.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Where the Next.js app is reachable. Put your LAN IP or tunnel host here so the
# merchant QR codes resolve on a phone, e.g. http://192.168.1.20:3000
PUBLIC_BASE_URL=http://localhost:3000
